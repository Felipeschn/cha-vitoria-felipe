# Configuração usada somente pelos Route Handlers no servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Código de convite do casal, no mesmo formato dos demais: oito caracteres do
# alfabeto ABCDEFGHJKMNPQRSTUVWXYZ23456789, com ou sem hífen no meio.
GIFT_ADMIN_CODE=ABCD-EFGH
INVITATION_CODE_SECRET=troque-por-64-caracteres-hexadecimais-aleatorios
